// Firestore Security Rules for Vikas Public School Website
//
// Public visitors can read website content. Only the school admin account,
// signed in through admin.html (Firebase Auth), can change it.
//
// Deploy:  firebase deploy --only firestore:rules
//   or paste this file into Firebase Console -> Firestore Database -> Rules -> Publish.
//
// Before deploying, make sure a user with exactly the email below exists in
// Firebase Console -> Authentication -> Users, or admin saves will be rejected.
// To add another admin, add their email to the list in isAdmin().

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // email_verified is deliberately not required: accounts created in the
    // Firebase console are unverified by default. Add it once the account is verified.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['admin@vikaspublicschool.in'];
    }

    function isContentCollection(collection) {
      return collection in [
        'faculty', 'gallery', 'testimonials', 'events', 'faq',
        'settings', 'cache', 'disclosure_rows'
      ];
    }

    match /{collection}/{document} {
      allow read: if isContentCollection(collection);
      allow write: if isAdmin() && isContentCollection(collection);
    }
  }
}
